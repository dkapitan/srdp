# Relaxed yamllint — accommodates GitHub Actions (${{ }}), Flux/kustomize
# manifests, and flow-style maps in Helm values.
extends: default

rules:
  line-length: disable
  document-start: disable
  truthy: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    spaces: consistent
    indent-sequences: consistent

ignore: |
  .terraform/
