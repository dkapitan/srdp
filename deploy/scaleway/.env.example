# Company-specific configuration. Copy to `.env` (gitignored) and fill in.
# This is the ONLY place Project IDs and the org name live.

# Short, lowercase, ALPHANUMERIC org code — used in resource names.
# Registry/bucket names allow hyphens but keep this short (e.g. "acme").
ORG_PREFIX=acme

REGION=nl-ams
ZONE=nl-ams-1   # RDB private networking requires the default AZ

# One Organization, four Projects (create them in the Scaleway console first).
PROJECT_ID_HUB=00000000-0000-0000-0000-000000000000    # connectivity / hub
PROJECT_ID_DEV=00000000-0000-0000-0000-000000000000
PROJECT_ID_STAGE=00000000-0000-0000-0000-000000000000
PROJECT_ID_PROD=00000000-0000-0000-0000-000000000000

# IAM API key used by Terraform + the S3 state backend.
# https://console.scaleway.com/iam/api-keys
# 1. Create a new application called "Terraform".
# 2. Give it a policy with these permission sets across ALL Projects (and the
#    Organization, for IAM):
#    - Editors (manage resources), AND
#    - ObjectStorageFullAccess (S3 data path for the state backend + lakehouse;
#      Editors alone does NOT grant S3 object access), AND
#    - IAMManager (Terraform creates the workload-identity IAM apps/keys;
#      Editors does NOT include IAM management).
# 3. Generate an API key with "Terraform" as the bearer.
# 4. IMPORTANT: set the key's PREFERRED PROJECT to the hub Project. Scaleway's S3
#    API resolves buckets only within the key's preferred Project, so all
#    Terraform state lives in one bucket there (see TFSTATE_BUCKET below).
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=00000000-0000-0000-0000-000000000000

# Organization ID — required: IAM applications/policies are Organization-scoped,
# and the provider reads this to create them. (console -> Organization -> Settings)
SCW_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Shared Terraform-state bucket (must live in the key's preferred Project).
# Defaults to ${ORG_PREFIX}-tfstate-hub. Override only if your preferred Project
# is not hub (e.g. TFSTATE_BUCKET=acme-tfstate-prd).
# TFSTATE_BUCKET=acme-tfstate-hub
